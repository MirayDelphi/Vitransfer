<Application x:Class="Vitransfer.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Vitransfer.App">
 <Application.Resources>
  <local:IconImageConverter x:Key="IconImageConverter"/>
  <SolidColorBrush x:Key="Accent" Color="#80DEB4"/>
  <Style TargetType="ContextMenu">
   <Setter Property="Background" Value="#101A29"/><Setter Property="Foreground" Value="#E7EDF5"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
    <Border Background="{TemplateBinding Background}" BorderBrush="#536780" BorderThickness="1" CornerRadius="4" Padding="4"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="MenuItem">
   <Setter Property="Foreground" Value="#E7EDF5"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="14,9"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
    <Border x:Name="MenuSurface" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuSurface" Property="Background" Value="#3C526F"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#94A6BE"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E7EDF5"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#29374C"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#3C526F"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#80DEB4"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#101A29"/><Setter Property="Foreground" Value="#E7EDF5"/><Setter Property="BorderBrush" Value="#34445C"/><Setter Property="Padding" Value="10"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="#101A29"/><Setter Property="Foreground" Value="#E7EDF5"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <Border Background="{TemplateBinding Background}" BorderBrush="#34445C" BorderThickness="1"/>
     <TextBox x:Name="PART_EditableTextBox" Margin="0,0,32,0" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" BorderThickness="0" Padding="10" VerticalContentAlignment="Center"/>
     <ToggleButton Width="32" HorizontalAlignment="Right" Content="▾" Background="#29374C" Foreground="White" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
     <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
      <Border Background="#101A29" BorderBrush="#34445C" BorderThickness="1"><ScrollViewer MaxHeight="240" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border>
     </Popup>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#E7EDF5"/><Setter Property="Padding" Value="10,8"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#101A29"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#E7EDF5"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,2"/></Style>
  <DataTemplate x:Key="GameTemplate">
   <Grid Margin="2,5"><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Width="48" Height="48" CornerRadius="9" Background="#29374C"><Grid><TextBlock Text="🎮" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding IconPath, Converter={StaticResource IconImageConverter}}" Stretch="Uniform"/></Grid></Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding SizeDisplay}" Foreground="#80DEB4" FontSize="12" Margin="10,2,0,0" ToolTip="Game, DLC, update and rePatch folder size; excludes saves"/><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#94A6BE" FontSize="12" Margin="0,5,0,0"/></StackPanel>
   </Grid>
  </DataTemplate>
 </Application.Resources>
</Application>
