<Window Icon="/Assets/app.ico" x:Class="Vitransfer.App.DlcDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Installed DLC" Width="640" Height="460" MinWidth="440" MinHeight="300" WindowStartupLocation="CenterOwner" Background="#0B1220" FontFamily="Segoe UI" ShowInTaskbar="False" Loaded="Window_Loaded" Closing="Window_Closing">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock x:Name="GameName" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Installed content · names read from SFO metadata" Foreground="#94A6BE" Margin="0,6,0,0"/></StackPanel>
  <ListBox x:Name="Dlcs" Grid.Row="1"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,6"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Foreground="#94A6BE" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
  <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="Reading DLC metadata…" Foreground="#94A6BE" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Close" IsCancel="True" Click="Close_Click"/></Grid>
 </Grid>
</Window>
