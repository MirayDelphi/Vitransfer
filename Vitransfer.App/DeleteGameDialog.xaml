<Window Icon="/Assets/app.ico" x:Class="Vitransfer.App.DeleteGameDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Delete game" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#0B1220" FontFamily="Segoe UI" ShowInTaskbar="False">
 <StackPanel Margin="24" Width="480">
  <TextBlock x:Name="GameName" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <TextBlock Text="Are you sure you want to delete this game, DLC and all related content?" TextWrapping="Wrap" FontSize="14"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
   <Button Content="Keep saves" Click="KeepSaves_Click"/>
   <Button Content="Delete" Click="Delete_Click"/>
   <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" IsDefault="True"/>
  </StackPanel>
 </StackPanel>
</Window>
